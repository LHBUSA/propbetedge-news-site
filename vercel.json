{
  "rewrites": [
    { "source": "/news/rss.xml", "destination": "/api/rss?mode=all" },
    { "source": "/news/breaking/rss.xml", "destination": "/api/rss?mode=breaking" },
    { "source": "/news/:sport(mlb|nfl|nba|nhl)/rss.xml", "destination": "/api/rss?sport=:sport" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap?type=index" },
    { "source": "/news-sitemap.xml", "destination": "/api/sitemap?type=news" },
    { "source": "/sitemaps/news-current.xml", "destination": "/api/sitemap?type=news" },
    { "source": "/sitemaps/static.xml", "destination": "/api/sitemap?type=static" },
    { "source": "/sitemaps/entities.xml", "destination": "/api/sitemap?type=entities" },
    { "source": "/sitemaps/players-:sport.xml", "destination": "/api/sitemap?type=players&sport=:sport" },
    { "source": "/sitemaps/games-:sport.xml", "destination": "/api/sitemap?type=games&sport=:sport" },
    { "source": "/sitemaps/archive-:chunk.xml", "destination": "/api/sitemap?type=article-chunk&chunk=:chunk" },
    { "source": "/sitemaps/articles.xml", "destination": "/api/sitemap?type=articles" },
    { "source": "/sitemaps/articles-:month.xml", "destination": "/api/sitemap?type=articles&month=:month" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/news/:path*", "destination": "/index.html" },
    { "source": "/authors/:path*", "destination": "/index.html" },
    { "source": "/author/:path*", "destination": "/index.html" },
    { "source": "/editorial-standards", "destination": "/index.html" },
    { "source": "/((?!api|_next|_vercel|favicon|logo|src|public|assets|manifest|sitemap|robots|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/social/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://propsports.proptechusa.ai https://www.propsports.proptechusa.ai;" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
